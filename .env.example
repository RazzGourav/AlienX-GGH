# ResQBharat Environment Variables

# Google Gemini API Key (Server-Side)
# Required for autonomous multi-agent reasoning (Coordinator, Triage, Logistics, Surveillance, Reporter)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key (Client-Side, Optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# CARTO Basemaps API Key (Client-Side, Optional)
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here
